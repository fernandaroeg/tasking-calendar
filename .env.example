# Firebase Client Configuration Template
# Copy this file to .env and replace with your project's actual configuration keys.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Mailtrap API configuration for email notifications
VITE_MAILTRAP_API_TOKEN=your_mailtrap_api_token
VITE_MAILTRAP_SENDER_EMAIL=no-reply@ibermex.com.mx
VITE_MAILTRAP_SENDER_NAME="Ibermex Cal"
